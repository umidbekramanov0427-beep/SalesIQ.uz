{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "salesos-elite-crm",
      "version": "0.1.0",
      "title": "SalesIQ CRM"
    },
    "tools": [
      {
        "name": "list_leads",
        "title": "List leads",
        "description": "List CRM leads from SalesIQ, optionally filtered by stage, temperature, owner or a free-text search over name/company.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "search": {
              "description": "Free-text match on lead name or company.",
              "type": "string"
            },
            "stage": {
              "description": "Pipeline stage name filter, e.g. Qualified, Demo, Won.",
              "type": "string"
            },
            "temperature": {
              "type": "string",
              "enum": [
                "Hot",
                "Warm",
                "Cold"
              ]
            },
            "owner": {
              "description": "Lead owner full name.",
              "type": "string"
            },
            "limit": {
              "description": "Max rows to return (default 25).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_lead",
        "title": "Get lead detail",
        "description": "Get the full CRM workspace record for one lead: contact details, deal context, recent activity timeline and open tasks.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "lead_id": {
              "type": "string",
              "minLength": 1,
              "description": "Lead id (UUID)."
            }
          },
          "required": [
            "lead_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_deals",
        "title": "List deals",
        "description": "List deals in the SalesIQ pipeline with value, probability, stage and owner.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "stage": {
              "description": "Deal stage name filter, e.g. Negotiation, Proposal, Won.",
              "type": "string"
            },
            "owner": {
              "description": "Deal owner full name.",
              "type": "string"
            },
            "min_value": {
              "description": "Only deals worth at least this amount.",
              "type": "number"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "pipeline_summary",
        "title": "Pipeline summary",
        "description": "Summarize the sales pipeline: lead and deal counts, total and weighted value per stage.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "leaderboard_ranking",
        "title": "Sales leaderboard",
        "description": "Get the current SalesIQ sales leaderboard ranking: revenue, conversion, KPI and target completion per manager, computed from real CRM leads.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "search": {
              "description": "Filter managers by name.",
              "type": "string"
            },
            "limit": {
              "description": "How many ranks to return (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
