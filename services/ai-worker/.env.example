# Supabase project (Settings -> API). Service-role key: server only, never in a browser.
SUPABASE_URL=https://api.salesiq.uz
SUPABASE_SERVICE_ROLE_KEY=

# The SalesIQ app and the shared secret its /audio-analytics/analyze-one checks.
# Put the SAME value into the app server's .env.server as WORKER_SECRET.
APP_BASE_URL=https://salesiq.uz
WORKER_SECRET=

# Bearer key for this service's /v1 endpoints (queue status, re-analysis jobs).
WORKER_API_KEY=

# Optional tuning
QUEUE_ENABLED=true
CONCURRENCY=3
BATCH_SIZE=20
POLL_INTERVAL_SECONDS=30
MAX_ATTEMPTS=3
ORG_BLOCK_MINUTES=30
AI_BUSY_BACKOFF_SECONDS=60
REQUEST_TIMEOUT_SECONDS=300
CORS_ORIGINS=https://salesiq.uz,https://www.salesiq.uz
